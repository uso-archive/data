    "css": "@-moz-document url-prefix(\"https://open.spotify.com\") {\n:root {\r\n    /* Pixel city background (base64 embedded) */\r\n    --city-bg: url(\"data:image/png;base64,\");\r\n    --overlay-color: rgba(0, 0, 0, 0.55);\r\n  }\r\n\r\n  /* Apply background across whole app */\r\n  body,\r\n  #main,\r\n  .Root,\r\n  .os-viewport,\r\n  .main-view-container,\r\n  .main-view-container__scroll-node {\r\n    background: linear-gradient(var(--overlay-color), var(--overlay-color)),\r\n                var(--city-bg) no-repeat center center fixed !important;\r\n    background-size: cover !important;\r\n  }\r\n\r\n  /* Left sidebar */\r\n  [class*=\"navBar\"],\r\n  aside {\r\n    background-color: rgba(0,0,0,0.35) !important;\r\n    backdrop-filter: blur(6px) !important;\r\n  }\r\n\r\n  /* Top bar */\r\n  [class*=\"topBar\"],\r\n  header {\r\n    background-color: rgba(0,0,0,0.35) !important;\r\n    backdrop-filter: blur(6px) !important;\r\n  }\r\n\r\n  /* Bottom player bar */\r\n  [class*=\"nowPlayingBar\"],\r\n  footer {\r\n    background-color: rgba(0,0,0,0.35) !important;\r\n    backdrop-filter: blur(6px) !important;\r\n  }\r\n\r\n  /* Text and icons */\r\n  .Type__TypeElement-sc-goli3j-0,\r\n  .spoticon,\r\n  button,\r\n  span,\r\n  h1,h2,h3,h4,h5,h6 {\r\n    color: #ffffff !important;\r\n    text-shadow: 0 1px 2px rgba(0,0,0,0.6);\r\n  }\r\n\r\n  /* Progress bar and controls */\r\n  .progress-bar,\r\n  .playback-bar,\r\n  .progress-bar__slider {\r\n    filter: brightness(1.2) contrast(1.1) !important;\r\n  }\r\n\r\n  /* Modals darker */\r\n  .Modal,\r\n  .modal-root {\r\n    background-color: rgba(0, 0, 0, 0.75) !important;\r\n  }\n}\n",
