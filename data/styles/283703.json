  "style": {
    "css": "/* ==UserStyle==\r\n@name           Stylish Custom Theme Template\r\n@namespace      ://github.com\r\n@version        1.0.0\r\n@description    A modern, customizable dark/light mode template for user styles.\r\n@author         Your Name\r\n==UserStyle== */\n@-moz-document domain(\"example.com\"), url-prefix(\"https://example.com\") {\n/* 1. GLOBAL ROOT VARIABLES */\r\n    :root {\r\n        --bg-primary: #121212;\r\n        --bg-secondary: #1e1e1e;\r\n        --accent-color: #3b82f6;\r\n        --text-main: #f3f4f6;\r\n        --text-muted: #9ca3af;\r\n        --border-color: #374151;\r\n        --border-radius: 8px;\r\n        --transition-speed: 0.3s ease;\r\n    }\r\n\r\n    /* 2. BASE RESET & OVERRIDES */\r\n    body {\r\n        background-color: var(--bg-primary) !important;\r\n        color: var(--text-main) !important;\r\n        font-family: 'Inter', system-ui, -apple-system, sans-serif !important;\r\n    }\r\n\r\n    /* 3. CORE STRUCTURAL LAYOUTS */\r\n    header, .main-header, #nav-bar {\r\n        background-color: var(--bg-secondary) !important;\r\n        border-bottom: 1px solid var(--border-color) !important;\r\n    }\r\n\r\n    main, .content-container, #main-wrapper {\r\n        background-color: var(--bg-primary) !important;\r\n    }\r\n\r\n    footer, .site-footer {\r\n        background-color: var(--bg-secondary) !important;\r\n        border-top: 1px solid var(--border-color) !important;\r\n    }\r\n\r\n    /* 4. REUSABLE COMPONENTS & UTILITIES */\r\n    a, .link {\r\n        color: var(--accent-color) !important;\r\n        transition: color var(--transition-speed);\r\n    }\r\n\r\n    a:hover {\r\n        text-decoration: underline !important;\r\n        opacity: 0.9;\r\n    }\r\n\r\n    button, .btn-primary, input[type=\"submit\"] {\r\n        background-color: var(--accent-color) !important;\r\n        color: #ffffff !important;\r\n        border-radius: var(--border-radius) !important;\r\n        border: none !important;\r\n        padding: 8px 16px !important;\r\n        cursor: pointer !important;\r\n    }\r\n\r\n    input, textarea, select {\r\n        background-color: var(--bg-secondary) !important;\r\n        color: var(--text-main) !important;\r\n        border: 1px solid var(--border-color) !important;\r\n        border-radius: var(--border-radius) !important;\r\n        padding: 6px 12px !important;\r\n    }\r\n\r\n    /* 5. CARD LAYOUTS & SIDEBARS */\r\n    .card, .sidebar, .widget, [class*=\"card\"] {\r\n        background-color: var(--bg-secondary) !important;\r\n        border: 1px solid var(--border-color) !important;\r\n        border-radius: var(--border-radius) !important;\r\n        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5) !important;\r\n    }\r\n\r\n    /* 6. UTILITY HIDDEN FIELDS (Remove annoying ads or elements) */\r\n    .ad-container, #promo-banner, .promoted-content {\r\n        display: none !important;\r\n    }\n}\n",
